# ========================
# 🛠 Unity 기본 무시 파일
# ========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# 🔄 Unity 메타 데이터 (자산은 포함, 단독 메타 제외)
# !/[Aa]ssets/**/*.meta

# Unity Auto-generated
ExportedObj/
*.pidb
*.pidb.meta
*.pdb.meta
*.booproj
*.svd
*.tmp

# ========================
# 📦 빌드 결과물 (Android/iOS 등)
# ========================
*.apk
*.aab
*.ipa
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
*.gradle/
.gradle/

# ========================
# 🧪 IDE 설정 및 프로젝트 파일
# ========================
# VS / Rider / JetBrains
.idea/
.vscode/
*.sln
*.csproj
*.unityproj
*.user
*.userprefs
*.suo
*.tmp
*.iws
*.iml
.idea_modules/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/.name

[Aa]ssets/Models/
[Aa]ssets/Quirky Series Ultimate/

# JetBrains Rider Plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# ========================
# 📦 패키지, 외부 라이브러리
# ========================
# DOTween auto-generated
Assets/Resources/DOTweenSettings.asset

# Unity Asset Store
AssetStoreTools*

# ========================
# 🔥 Firebase / Crashlytics
# ========================
firebase-*.json
.crashlytics/
Assets/Firebase/Plugins/x86_64/*.so
Assets/Firebase/Plugins/x86_64/*.bundle

# ========================
# ✅ 반드시 포함해야 하는 항목
# ========================
!Assets/
!Packages/
!ProjectSettings/
!ProjectSettings/ProjectVersion.txt
!ProjectSettings/EditorBuildSettings.asset
!ProjectSettings/TagManager.asset

# Firebase 설정은 Git에 포함 (필요 시 관리)
!Assets/StreamingAssets/google-services.json
!Assets/GoogleService-Info.plist

